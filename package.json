{
  "name": "@cryptos-pki/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @cryptos-pki/console",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate": "npm run generate -w @cryptos-pki/api-client",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@bugs5382/node-oxlint-config": "^1.0.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "browserslist": "4.29.3",
    "postcss-selector-parser": "7.1.6"
  }
}
