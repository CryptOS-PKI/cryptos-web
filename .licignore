# GoLic ignore file -- https://github.com/Bugs5382/golic
# Ignore everything...
*

# ...but inject the Apache 2.0 header into these source types:
!*.ts
!*.tsx
!*.js
!*.mts
!*.mjs
!*.cjs

# ...even when they live in subdirectories:
!*/

# golic skips *.d.ts by default; this one is hand-written and keeps its header.
!apps/console/src/vite-env.d.ts

# Never the build output, deps, caches, or generated docs:
/node_modules/**
**/node_modules/**
/dist/**
**/dist/**
/coverage/**
**/coverage/**

# The api-client stubs, generated by protoc-gen-es from the node and fleet
# protos (packages/api-client/scripts/generate.sh).
/packages/api-client/src/gen/**
/packages/api-client/.protos/**
